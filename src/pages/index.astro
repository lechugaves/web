---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="LechugaVES te ayuda a consultar y convertir tasas de cambio entre divisas y el bolívar venezolano."
    />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>LechugaVES</title>
  </head>

  <body>
    <main>
      <section class="hero">
        <img
          class="logo"
          src="/branding/logo-horizontal-white.svg"
          alt="LechugaVES"
        />
      </section>

      <section class="intro">
        <p class="tagline">
          Próximamente, una nueva forma de consultar las tasas de cambio entre
          distintas divisas y el bolívar venezolano (<span>VES</span>).
        </p>
      </section>
    </main>
  </body>
</html>
