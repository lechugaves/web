---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "LechugaVES",
  description = "LechugaVES te ayuda a consultar y convertir tasas de cambio entre divisas y el bolívar venezolano.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={description}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
