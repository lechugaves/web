<section id="app" class="app-preview" aria-labelledby="app-preview-title">
  <div class="app-preview__content">
    <p class="app-preview__eyebrow">Diseñada para el día a día</p>

    <h2 id="app-preview-title" class="app-preview__title">
      Una experiencia simple para consultar tus tasas.
    </h2>

    <p class="app-preview__description">
      Accede rápidamente a las referencias disponibles y realiza conversiones
      desde una interfaz clara tanto en modo claro como oscuro.
    </p>
  </div>

  <div class="app-preview__screens-wrapper">
    <div class="app-preview__screens">
      <figure class="app-preview__screen app-preview__screen--light">
        <img
          src="/screenshots/converter-light.jpg"
          alt="LechugaVES mostrando la conversión de dólares a bolívares en modo claro"
          width="920"
          height="2048"
          loading="lazy"
        />
      </figure>

      <figure class="app-preview__screen app-preview__screen--dark">
        <img
          src="/screenshots/converter-dark.jpg"
          alt="LechugaVES mostrando la conversión de euros a bolívares en modo oscuro"
          width="920"
          height="2048"
          loading="lazy"
        />
      </figure>
    </div>

    <p class="app-preview__caption">Imágenes ilustrativas</p>
  </div>
</section>
